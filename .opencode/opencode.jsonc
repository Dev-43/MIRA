{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "@context7/mcp-server"]
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--headless"]
    },
    "neo4j": {
      "type": "local",
      "command": ["uvx", "mcp-neo4j-cypher"],
      "environment": {
        "NEO4J_URI": "bolt://127.0.0.1:7687",
        "NEO4J_USERNAME": "neo4j",
        "NEO4J_PASSWORD": "95175310"
      }
    },
    "github": {
      "type": "local",
      "command": ["npx", "@modelcontextprotocol/server-github"]
    },
    "git": {
      "type": "local",
      "command": ["npx", "@modelcontextprotocol/server-git"]
    },
    "sentry": {
      "type": "local",
      "command": ["npx", "@sentry/mcp-server"]
    },
    "firecrawl": {
      "type": "local",
      "command": ["npx", "@mendable/firecrawl-mcp"]
    },
    "figma": {
      "type": "local",
      "command": ["npx", "@figma/mcp-server"]
    },
    "linear": {
      "type": "local",
      "command": ["npx", "@linear/mcp-server"]
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "exa": {
      "type": "local",
      "command": ["npx", "@exa/mcp-server"]
    },
    "21st-dev": {
      "type": "local",
      "command": ["npx", "@21st-dev/mcp-server"]
    },
    "shadcn-ui": {
      "type": "local",
      "command": ["npx", "@shadcn/mcp-server"]
    },
    "lucide": {
      "type": "local",
      "command": ["npx", "@lucide/mcp-server"]
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "@modelcontextprotocol/server-chrome"]
    }
  }
}